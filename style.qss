/*
  style.qss - Fichier de style global pour l'application Leopardo ERP
  Auteur: Jules
  Version: 2.0 - Refonte "Modern Professional"
*/

/* -------------------
   Variables de Couleur (Conceptuelles)
   ------------------- */
/*
  :root {
    --primary-color: #4A90E2; / Bleu doux
    --primary-hover: #357ABD;
    --primary-pressed: #2A6293;

    --secondary-color: #50E3C2; / Vert menthe
    --secondary-hover: #3CCBAA;
    --secondary-pressed: #2FA38C;

    --danger-color: #D0021B; / Rouge
    --danger-hover: #B00217;

    --background-light: #F7F9FC;
    --background-medium: #FFFFFF;
    --background-dark: #2c3e50;

    --text-main: #34495e;
    --text-light: #7f8c8d;
    --text-on-dark: #ecf0f1;

    --border-color: #E0E6ED;
    --shadow-color: rgba(0, 0, 0, 0.08);
  }
*/

/* -------------------
   Styles Généraux
   ------------------- */
QWidget {
    font-family: 'Inter', 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
    font-size: 10pt;
    color: #34495e; /* --text-main */
    background-color: #F7F9FC; /* --background-light */
}

/* -------------------
   Barre de Titre et Contrôles Fenêtre
   ------------------- */
#topMenuBarWidget {
    background-color: #FFFFFF; /* --background-medium */
    border-bottom: 1px solid #E0E6ED; /* --border-color */
}

QLabel#topMenuAppTitle {
    color: #4A90E2; /* --primary-color */
    font-size: 18px;
    font-weight: 600; /* semi-bold */
    padding-left: 5px;
}

#windowControlButton {
    background-color: transparent;
    border: none;
    font-size: 14px;
    color: #7f8c8d; /* --text-light */
    border-radius: 5px;
    min-width: 32px;
    min-height: 32px;
}
#windowControlButton:hover {
    background-color: #F0F3F5;
    color: #34495e; /* --text-main */
}
#windowCloseButton:hover {
    background-color: #D0021B; /* --danger-color */
    color: white;
}

/* -------------------
   Barre Latérale de Navigation
   ------------------- */
#SidebarNavigationWidget {
    background-color: #2c3e50; /* --background-dark */
    color: #ecf0f1; /* --text-on-dark */
}

#sidebarToggleButton, #sidebarModuleButton {
    background-color: transparent;
    color: #ecf0f1;
    border: none;
    text-align: left;
    padding: 14px 20px;
    font-size: 10pt;
    border-radius: 4px;
    margin: 2px 8px;
}

#sidebarToggleButton:hover, #sidebarModuleButton:hover {
    background-color: #34495e; /* Darker shade */
}

#sidebarModuleButton:checked {
    background-color: #4A90E2; /* --primary-color */
    color: white;
    font-weight: 600;
}

/* -------------------
   Conteneurs et Groupes
   ------------------- */
QGroupBox {
    background-color: #FFFFFF; /* --background-medium */
    border: 1px solid #E0E6ED; /* --border-color */
    border-radius: 8px;
    margin-top: 1ex;
    padding: 15px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 15px;
    color: #4A90E2; /* --primary-color */
    font-weight: 600;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] { /* HLine, VLine */
    border: none;
    background-color: #E0E6ED; /* --border-color */
}

/* -------------------
   Champs de Saisie
   ------------------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit {
    background-color: #FFFFFF;
    border: 1px solid #E0E6ED; /* --border-color */
    border-radius: 6px;
    padding: 8px 10px;
    selection-background-color: #4A90E2; /* --primary-color */
    selection-color: white;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QDateTimeEdit:focus {
    border-color: #4A90E2; /* --primary-color */
    box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.2); /* Effet d'ombre focus */
}

QLineEdit[readOnly="true"] {
    background-color: #F0F3F5;
    color: #7f8c8d; /* --text-light */
}

/* -------------------
   Boutons
   ------------------- */
QPushButton {
    background-color: #FFFFFF;
    color: #34495e; /* --text-main */
    border: 1px solid #E0E6ED; /* --border-color */
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #F7F9FC;
    border-color: #C8D0D9;
}

QPushButton:pressed {
    background-color: #E0E6ED;
}

QPushButton:disabled {
    background-color: #F0F3F5;
    color: #bdc3c7;
    border-color: #E0E6ED;
}

/* Boutons Primaires */
QPushButton#primaryButton, QPushButton#save_settings_button {
    background-color: #4A90E2; /* --primary-color */
    color: white;
    border: none;
}
QPushButton#primaryButton:hover, QPushButton#save_settings_button:hover {
    background-color: #357ABD; /* --primary-hover */
}
QPushButton#primaryButton:pressed, QPushButton#save_settings_button:pressed {
    background-color: #2A6293; /* --primary-pressed */
}

/* Boutons de Danger */
QPushButton#dangerButton {
    background-color: #D0021B; /* --danger-color */
    color: white;
    border: none;
}
QPushButton#dangerButton:hover {
    background-color: #B00217; /* --danger-hover */
}

/* -------------------
   QComboBox
   ------------------- */
QComboBox {
    background-color: white;
    border: 1px solid #E0E6ED; /* --border-color */
    border-radius: 6px;
    padding: 8px 10px;
}

QComboBox:hover {
    border-color: #C8D0D9;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left-width: 1px;
    border-left-color: #E0E6ED;
    border-left-style: solid;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    border: 1px solid #E0E6ED;
    background-color: white;
    selection-background-color: #4A90E2;
    selection-color: white;
    padding: 4px;
}

/* -------------------
   QTabWidget
   ------------------- */
QTabWidget::pane {
    border: 1px solid #E0E6ED;
    border-top: none;
    background: white;
    border-radius: 0 0 8px 8px;
}

QTabBar::tab {
    background: transparent;
    color: #7f8c8d; /* --text-light */
    border: 1px solid transparent;
    border-bottom: none;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background: white;
    color: #4A90E2; /* --primary-color */
    border-color: #E0E6ED;
    border-bottom-color: white; /* Pour fusionner avec le pane */
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background: #F7F9FC;
    color: #34495e;
}

QTabBar::close-button {
    image: url(:/icons/x.svg);
    subcontrol-position: right;
    margin-left: 5px;
}
QTabBar::close-button:hover {
    background: #E0E6ED;
    border-radius: 50%;
}

/* -------------------
   QListWidget
   ------------------- */
QListWidget {
    background-color: white;
    border: 1px solid #E0E6ED;
    border-radius: 8px;
}

QListWidget::item {
    padding: 10px 15px;
    border-bottom: 1px solid #F0F3F5;
}

QListWidget::item:selected {
    background-color: #EAF2FC;
    color: #2A6293;
    border-left: 4px solid #4A90E2;
    padding-left: 11px;
}

QListWidget::item:hover:!selected {
    background-color: #F7F9FC;
}

/* -------------------
   QTableWidget
   ------------------- */
QTableWidget {
    gridline-color: #E0E6ED;
    background-color: white;
    border: 1px solid #E0E6ED;
    border-radius: 8px;
    selection-behavior: SelectRows;
}

QHeaderView::section {
    background-color: #F7F9FC;
    padding: 10px;
    border: none;
    border-bottom: 1px solid #E0E6ED;
    font-weight: 600;
    color: #34495e;
}

QTableWidget::item {
    padding: 10px;
    border: none;
    border-bottom: 1px solid #F0F3F5;
}

QTableWidget::item:selected {
    background-color: #4A90E2;
    color: white;
}

/* -------------------
   Composants Spécifiques
   ------------------- */

/* Page d'accueil */
#HomePageWidget {
    background-color: #F7F9FC;
}

#homePageSearchInput {
    border: 1px solid #E0E6ED;
    border-radius: 20px; /* Complètement arrondi */
    padding: 10px 20px;
    font-size: 11pt;
}

#homePageSearchButton {
    background-color: #4A90E2;
    border: none;
    border-radius: 20px;
    min-width: 40px;
    min-height: 40px;
}

#homePageSearchButton:hover {
    background-color: #357ABD;
}

/* Cartes de module */
#moduleCard {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ffffff, stop:1 #F7F9FC);
    border: 1px solid #E0E6ED;
    border-radius: 12px;
    transition: all 0.3s ease;
}

#moduleCard:hover {
    border-color: #4A90E2;
    transform: translateY(-5px); /* Conceptuel, non supporté */
}

#moduleTitleLabel {
    font-size: 11pt;
    font-weight: 600;
    color: #34495e;
}

#statValueLabel {
    font-size: 18pt;
    font-weight: 700;
    color: #2c3e50;
}

#statTextLabel {
    font-size: 9pt;
    color: #7f8c8d;
}

/* Liste des clients */
#leftPaneWidget {
    background-color: #FFFFFF;
    border-right: 1px solid #E0E6ED;
}

#clientListWidget {
    border: none;
    background-color: transparent;
}

ClientListItemWidget {
    background-color: transparent;
    border-bottom: 1px solid #F0F3F5;
    padding: 8px 0;
}

ClientListItemWidget:hover {
    background-color: #F7F9FC;
}

#clientNameInList {
    font-size: 11pt;
    font-weight: 500;
    color: #34495e;
}

#clientAdditionalInfoInList {
    color: #7f8c8d;
}

#listItemActionButton {
    background-color: transparent;
    border: none;
    padding: 4px;
    border-radius: 4px;
}

#listItemActionButton:hover {
    background-color: #E0E6ED;
}

/* ScrollBar */
QScrollBar:vertical {
    border: none;
    background: #F7F9FC;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #C8D0D9;
    min-height: 25px;
    border-radius: 5px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Splitter */
QSplitter::handle {
    background-color: #E0E6ED;
}
QSplitter::handle:hover {
    background-color: #4A90E2;
}
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
