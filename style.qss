/*
  styles.qss - Fichier de style global pour l'application DocumentManager
  Auteur: [Votre Nom]
  Version: 1.2
*/

/* Styles globaux pour tous les widgets */
QWidget {
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10pt; /* Taille de police de base */
    color: #343A40; /* Couleur de texte principale (gris foncé) */
    background-color: #f8f9fa; /* Couleur de fond générale (gris très clair) */
}

/* Styles pour les QFrame, pour créer des séparateurs visuels */
QFrame[frameShape="4"], QFrame[frameShape="5"] { /* HLine, VLine */
    border: none;
    background-color: #dee2e6; /* Gris clair pour les lignes */
}

/* Styles pour les QGroupBox */
QGroupBox {
    background-color: #ffffff; /* Fond blanc pour les groupes */
    border: 1px solid #dee2e6; /* Bordure grise claire */
    border-radius: 8px; /* Coins arrondis */
    margin-top: 1ex; /* Espace pour le titre */
    padding: 10px; /* Espace intérieur */
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left; /* Position du titre */
    padding: 0 5px;
    left: 10px; /* Aligner avec le padding du groupe */
    color: #495057; /* Couleur du titre */
    font-weight: bold;
}

/* Styles pour les QLineEdit, QTextEdit */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 6px 8px; /* Padding intérieur */
    selection-background-color: #007bff;
    selection-color: white;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QDateTimeEdit:focus {
    border-color: #80bdff; /* Bordure bleue en focus */
}

QLineEdit[readOnly="true"] {
    background-color: #e9ecef; /* Fond gris clair pour les champs en lecture seule */
}

/* Styles pour les QPushButton */
QPushButton {
    background-color: #6c757d; /* Gris secondaire pour les boutons par défaut */
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
    min-width: 80px; /* Largeur minimale */
}

QPushButton:hover {
    background-color: #5a6268; /* Plus foncé au survol */
}

QPushButton:pressed {
    background-color: #545b62; /* Encore plus foncé quand pressé */
}

QPushButton:disabled {
    background-color: #adb5bd;
    color: #f8f9fa;
}

/* Bouton Primaire (ex: "Ajouter", "Sauvegarder") */
QPushButton#primaryButton {
    background-color: #007bff; /* Bleu primaire */
}
QPushButton#primaryButton:hover {
    background-color: #0069d9;
}
QPushButton#primaryButton:pressed {
    background-color: #0062cc;
}

/* Bouton de Danger (ex: "Supprimer") */
QPushButton#dangerButton {
    background-color: #dc3545; /* Rouge danger */
}
QPushButton#dangerButton:hover {
    background-color: #c82333;
}
QPushButton#dangerButton:pressed {
    background-color: #bd2130;
}

/* Styles pour QComboBox */
QComboBox {
    background-color: white;
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 5px 8px;
}

QComboBox:hover {
    border-color: #adb5bd;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #ced4da;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron-up.svg); /* Chemin vers une icône de chevron */
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView { /* Style de la liste déroulante */
    border: 1px solid #ced4da;
    background-color: white;
    selection-background-color: #007bff;
    color: #343A40;
}

/* Styles pour QTabWidget */
QTabWidget::pane {
    border: 1px solid #dee2e6;
    border-top: none;
    background: white;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

QTabBar::tab {
    background: #e9ecef;
    color: #495057;
    border: 1px solid #dee2e6;
    border-bottom: none; /* La bordure inférieure est gérée par le pane */
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: white;
    color: #007bff;
    border-color: #dee2e6;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background: #f8f9fa;
}

QTabBar::close-button {
    image: url(:/icons/x.svg);
    subcontrol-position: right;
    margin-left: 4px;
}

QTabBar::close-button:hover {
    background: #ced4da;
    border-radius: 2px;
}

/* Styles pour QCheckBox et QRadioButton */
QCheckBox, QRadioButton {
    spacing: 5px; /* Espace entre le contrôle et le texte */
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #ced4da;
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px; /* Rond pour les radio buttons */
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #007bff;
    border-color: #007bff;
    image: url(:/icons/check.svg); /* Icône de coche blanche */
}

QRadioButton::indicator:checked {
    image: url(:/icons/radio-checked-dot.svg); /* Point blanc pour radio */
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #e9ecef;
    border-color: #ced4da;
}

QCheckBox::indicator:checked:disabled, QRadioButton::indicator:checked:disabled {
    image: url(:/icons/check-disabled.svg); /* Icône grise pour désactivé */
}

QRadioButton::indicator:checked:disabled {
    image: url(:/icons/radio-checked-dot-disabled.svg);
}


/* Styles pour QListWidget */
QListWidget {
    background-color: white;
    border: 1px solid #dee2e6;
    border-radius: 4px;
}

QListWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #f1f3f5; /* Séparateur léger */
}

QListWidget::item:selected {
    background-color: #e7f1ff; /* Bleu très clair pour la sélection */
    color: #0056b3;
    border-left: 3px solid #007bff; /* Indicateur de sélection */
}

QListWidget::item:hover:!selected {
    background-color: #f8f9fa;
}

/* Styles pour QTableWidget */
QTableWidget {
    gridline-color: #dee2e6;
    background-color: white;
    border: 1px solid #ced4da;
    border-radius: 4px;
}

QHeaderView::section {
    background-color: #f8f9fa;
    padding: 6px;
    border-style: none;
    border-bottom: 1px solid #dee2e6;
    font-weight: bold;
}

QTableWidget::item {
    padding: 6px;
    border-bottom: 1px solid #f1f3f5;
}

QTableWidget::item:selected {
    background-color: #007bff;
    color: white;
}

/* Styles pour QScrollBar */
QScrollBar:vertical {
    border: 1px solid #e0e0e0;
    background: #f8f9fa;
    width: 14px;
    margin: 15px 0 15px 0;
    border-radius: 7px;
}
QScrollBar::handle:vertical {
    background: #c9d1d9;
    min-height: 20px;
    border-radius: 7px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 15px;
    subcontrol-origin: margin;
}
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    image: url(:/icons/chevron-right.svg); /* Utiliser des icônes de chevron */
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Styles pour QSplitter */
QSplitter::handle {
    background-color: #f8f9fa; /* Couleur du séparateur */
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}
QSplitter::handle:hover {
    background-color: #007bff; /* Mise en évidence au survol */
}

/* Styles pour QMenu */
QMenu {
    border: 1px solid #adb5bd;
    background-color: white;
    padding: 5px;
}

QMenu::item {
    padding: 8px 24px;
}

QMenu::item:selected {
    background-color: #007bff;
    color: white;
}

QMenu::separator {
    height: 1px;
    background: #e9ecef;
    margin-left: 10px;
    margin-right: 5px;
}

/* Styles pour QToolTip */
QToolTip {
    border: 1px solid #343A40;
    padding: 5px;
    border-radius: 4px;
    background-color: #343A40;
    color: white;
    opacity: 230; /* Légère transparence */
}

/* Styles pour la barre de titre personnalisée et les boutons de contrôle de la fenêtre */
#CustomTitleBar {
    background-color: #343a40; /* Fond sombre pour la barre de titre */
    padding: 5px;
}
#CustomTitleBar QLabel {
    color: white; /* Titre de la fenêtre en blanc */
    font-weight: bold;
}
#windowControlButton {
    background-color: transparent;
    color: #f8f9fa;
    border: none;
    font-size: 14px;
    min-width: 30px;
    min-height: 30px;
}
#windowControlButton:hover {
    background-color: #495057;
}
#windowCloseButton:hover {
    background-color: #e81123; /* Rouge pour le bouton de fermeture au survol */
}

/* Styles spécifiques aux composants de l'application */

/* Client List Item Widget */
#clientListWidget {
    background-color: #ffffff; /* Fond blanc pour la liste */
}

#clientListWidget::item {
    border: none; /* Pas de bordure par défaut, géré par le widget personnalisé */
}

#clientListWidget::item:selected {
    background-color: transparent; /* La sélection est gérée par le style du widget personnalisé */
}

ClientListItemWidget { /* Style le widget personnalisé lui-même */
    background-color: #ffffff;
    border-bottom: 1px solid #f0f2f5;
    padding: 5px 0;
}

ClientListItemWidget:hover {
    background-color: #f8f9fa; /* Léger gris au survol */
}

#clientNameInList {
    font-size: 11pt;
    font-weight: 500; /* semi-bold */
    color: #212529;
}

#clientAdditionalInfoInList {
    color: #6c757d; /* gris secondaire */
}

#listItemActionButton { /* Style pour les boutons d'action en ligne */
    background-color: transparent;
    border: none;
    padding: 4px;
    border-radius: 4px;
}

#listItemActionButton:hover {
    background-color: #e9ecef; /* Gris clair au survol */
}

/* Style pour QCompleter */
QCompleter QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    border-radius: 4px;
    font-size: 10pt;
}
QCompleter QAbstractItemView::item {
    padding: 5px;
}
QCompleter QAbstractItemView::item:selected {
    background-color: #007bff;
    color: white;
}

/* Styles pour la barre de menu supérieure (top_menu_bar_widget) */
#topMenuBarWidget {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    height: 50px;
}

/* Boutons dans la barre de menu supérieure */
QPushButton#topMenuButton {
    background-color: transparent;
    color: #4b5563; /* Texte gris foncé */
    border: none;
    font-size: 14px;
    padding: 8px 12px;
    border-radius: 6px;
}
QPushButton#topMenuButton:hover {
    background-color: #f3f4f6; /* Gris très clair au survol */
    color: #1f2937;
}
QPushButton#topMenuButton::menu-indicator {
    image: none; /* Masquer l'indicateur de menu déroulant par défaut */
}

/* Champ de recherche dans la barre de menu */
QLineEdit#topMenuBarSearch {
    padding: 6px 10px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background-color: #f9fafb;
    width: 250px; /* Largeur augmentée */
}
QLineEdit#topMenuBarSearch:focus {
    border-color: #3b82f6; /* Bleu pour le focus */
    background-color: white;
}

/* Titre de l'application dans la barre de menu */
QLabel#topMenuAppTitle {
    color: #1e3a8a; /* Bleu foncé */
    font-size: 20px; /* Plus grand */
    font-weight: 600; /* semi-bold */
}

/* Boutons de contrôle de la fenêtre (placés ici pour la spécificité) */
#windowControlButton {
    background-color: transparent;
    border: none;
    font-size: 16px;
    font-weight: bold;
    color: #6c757d; /* Gris */
    border-radius: 4px;
    min-width: 35px;
    min-height: 35px;
}
#windowControlButton:hover {
    background-color: #e9ecef; /* Gris clair au survol */
}
#windowCloseButton:hover {
    background-color: #dc3545; /* Rouge pour la fermeture */
    color: white;
}


/* Styles pour la barre latérale de navigation */
#SidebarNavigationWidget {
    background-color: #343a40; /* Fond sombre */
    color: #f8f9fa; /* Texte clair */
}

#sidebarToggleButton, #sidebarModuleButton {
    background-color: transparent;
    color: #f8f9fa;
    border: none;
    text-align: left;
    padding: 12px 15px;
    font-size: 11pt;
}

#sidebarToggleButton:hover, #sidebarModuleButton:hover {
    background-color: #495057; /* Gris plus clair au survol */
}

#sidebarModuleButton:checked {
    background-color: #007bff; /* Bleu pour l'élément actif */
    font-weight: bold;
}

/* Styles pour les icônes dans la barre latérale */
#sidebarModuleButton > QLabel {
    /* Si vous utilisez des QLabel pour les icônes */
    padding-right: 10px;
}

/* Notifications Panel */
#NotificationPanel {
    background-color: rgba(0, 0, 0, 0.85);
    border: 1px solid #495057;
}
#NotificationPanel QLabel {
    color: white;
}

#notificationTitleLabel {
    font-weight: bold;
    font-size: 12pt;
}

#notificationMessageLabel {
    font-size: 10pt;
}

#notificationButton {
    background-color: transparent;
    border: none;
}

/* STYLES SPÉCIFIQUES À LA PAGE D'ACCUEIL */
#homePageWidget {
    background-color: #ffffff;
}

#homePageWelcomeLabel {
    font-size: 24pt;
    font-weight: 300; /* Léger */
    color: #212529;
}

#homePageSearchBox {
    background-color: white;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    padding: 5px;
}

#homePageSearchInput {
    border: none;
    background-color: transparent;
    font-size: 12pt;
    padding: 8px;
}

#homePageSearchButton {
    background-color: #007bff;
    border: none;
    border-radius: 6px;
    padding: 8px;
}
#homePageSearchButton:hover {
    background-color: #0069d9;
}

#homePageModuleGrid {
    /* Le QFrame qui contient le QGridLayout */
}

/* ModuleCardWidget Styles */
#moduleCardBaseWidget {
    background-color: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 8px;
}
#moduleCardBaseWidget:hover {
    border-color: #007bff;
    /* On pourrait ajouter une légère ombre ici aussi */
}
#moduleCardIconLabel {
    /* Le QLabel pour l'icône */
}
#moduleCardNameLabel {
    font-size: 11pt;
    font-weight: 500;
    color: #343A40;
}
#moduleCardDescriptionLabel {
    font-size: 9pt;
    color: #6c757d;
}

#quickStatsWidget {
    background-color: #f8f9fa;
    border-left: 1px solid #e9ecef;
}

#quickStatsTitle {
    font-size: 14pt;
    font-weight: bold;
    color: #343A40;
    padding-bottom: 10px;
    border-bottom: 1px solid #dee2e6;
}

#statItemLabel {
    font-size: 10pt;
    color: #495057;
}

#statItemValue {
    font-size: 16pt;
    font-weight: bold;
    color: #007bff;
}

#quickStatsRefreshButton {
    background-color: transparent;
    border: none;
    padding: 5px;
}

#homePageMapWidget {
    /* Style pour le conteneur du widget de la carte */
}

/* FIN STYLES SPÉCIFIQUES À LA PAGE D'ACCUEIL */
#windowControlButton {
    background-color: transparent;
    border: none;
    font-size: 16px;
    color: #6c757d;
}

#windowControlButton:hover {
    background-color: #e9ecef;
}

#windowCloseButton:hover {
    background-color: #dc3545;
    color: white;
}
