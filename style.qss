/* Style pour les icônes à l'intérieur des boutons de la page d'accueil si nécessaire */
/* Actuellement, la taille est définie en Python. On pourrait ajouter des filtres ou des effets ici si Qt le supporte. */
/* QWidget#homePageButtonGridContainer QPushButton::icon { ... } */
/* Reset Filters Button */
QPushButton#resetFiltersButton {
    background-color: #FFFFFF;
    color: #DC3545; /* Danger color for text to indicate reset */
    border: 1px solid #DDE2E6;
    padding: 6px 10px;
    font-weight: normal;
    margin-top: 5px; /* Add some space above it */
}

QPushButton#resetFiltersButton:hover {
    background-color: #F5F7FA;
    border-color: #DC3545; /* Danger color border on hover */
    color: #C82333; /* Darker danger color text */
}

/* Table Action Buttons (using property selector for ClientWidget documents table) */
QPushButton[class="tableActionButton"] {
    background-color: transparent;
    border: none;
    padding: 1px; /* Minimal padding for icon buttons */
    color: #546E7A; /* Default secondary text color for icons */
    /* Fixed size is set in code (28x28), ensure icon fits well */
    /* min-width, min-height might not be needed if fixedSize is used */
    border-radius: 3px; /* Slight rounding for consistency */
}

QPushButton[class="tableActionButton"]:hover {
    color: #007BFF; /* Accent color on hover */
    background-color: #E3F2FD; /* Light blue background on hover */
}

QPushButton[class="tableActionButton"]:pressed {
    background-color: #CCE5FF; /* Darker blue when pressed */
    color: #0056B3;


}

/* User Menu Button in Menu Bar */
QPushButton#userMenuButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 16px; /* Half of the button's fixed size (32px / 2) */
    padding: 0px;
    min-width: 32px; /* Consistent with UserMenuButton fixed size */
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    /* icon-size: 20px; */ /* Icon size is best controlled from UserMenuButton.py if precise sizing needed */
}

QPushButton#userMenuButton:hover {
    background-color: #E0E0E0; /* Light grey hover */
}

QPushButton#userMenuButton:pressed {
    background-color: #CFD8DC; /* Slightly darker grey when pressed */
}

QPushButton#userMenuButton::menu-indicator {
    image: none; /* Hide default menu indicator arrow */
}

/* === Styles pour les améliorations de la Liste des Clients === */

/* Contrôles de Tri */
QWidget#leftPaneWidget QComboBox#sortByCombo,
QWidget#leftPaneWidget QComboBox#sortOrderCombo {
    min-width: 130px;
    margin-left: 5px;
    margin-right: 8px;
}

/* Actions en Ligne dans ClientListItemWidget */
/* Assumant que ClientListItemWidget a un objectName "clientListItem" pour spécificité, sinon ajuster */
QWidget#clientListItem QToolButton[objectName="listItemActionButton"] {
    background-color: transparent;
    border: none;
    padding: 2px;
    border-radius: 3px;
    color: #6c757d; /* Gris pour icônes non survolées */
    /* setFixedSize(22,22) ou setIconSize(18,18) en Python recommandé */
}

QWidget#clientListItem QToolButton[objectName="listItemActionButton"]:hover {
    background-color: #e9ecef;
    color: #007BFF;
}

/* Pagination Améliorée */
QWidget#leftPaneWidget QLineEdit#goToPageInput {
    max-width: 50px;
    /* padding: 5px; */ /* Hérité */
    /* text-align: center; */ /* Mieux en Python avec setAlignment(Qt.AlignCenter) */
    margin-left: 4px;
    margin-right: 4px;
}

QWidget#leftPaneWidget QPushButton#goToPageButton {
    padding: 5px 10px;
    min-width: 40px;
    /* margin-left: 2px; */ /* Si besoin d'ajuster l'espacement */
}

/* Optionnel: ajuster les boutons Précédent/Suivant s'ils ont des objectName */
QWidget#leftPaneWidget QPushButton#prevPageButton,
QWidget#leftPaneWidget QPushButton#nextPageButton {
    /* padding: 5px 8px; */ /* Exemple de réduction de padding */
}


/* === Sidebar Navigation Widget Styles === */
QWidget#sidebarNavigationWidget {
    background-color: #ECEFF1; /* Nuance de gris-bleu clair, distincte du contenu principal */
    border-right: 1px solid #CFD8DC; /* Bordure de séparation un peu plus visible */
    min-width: 60px; /* Largeur par défaut pour l'état rétracté */
    max-width: 60px;
}

QWidget#sidebarNavigationWidget[expanded="true"] {
    min-width: 220px; /* Largeur pour l'état déployé */
    max-width: 220px;
}

/* Optionnel: Logo dans la Sidebar */
QWidget#sidebarNavigationWidget QLabel#sidebarAppLogo {
    background-color: transparent; /* Important si la sidebar a un fond */
    padding: 10px 5px; /* Ajuster le padding */
    border-bottom: 1px solid #CFD8DC; /* Séparateur sous le logo */
    margin-bottom: 5px;
    /* qproperty-alignment: 'AlignCenter'; */ /* Mieux en code pour QLabel */
}

/* Conteneur des boutons de module dans la sidebar */
QWidget#sidebarNavigationWidget QWidget#sidebarButtonsContainer { /* Si vous utilisez un QWidget intermédiaire */
    background-color: transparent;
}

/* Boutons de Module dans la Sidebar */
/* Utilisation d'un sélecteur plus général et exclusion du toggleButton par son objectName */
QWidget#sidebarNavigationWidget QToolButton:not(#sidebarToggleButton) {
    border: none;
    border-radius: 4px; /* Coins légèrement arrondis */
    padding: 10px 0px; /* Padding vertical, horizontal géré par l'alignement du contenu */
    text-align: left;
    color: #37474F; /* Texte gris foncé */
    background-color: transparent;
    font-size: 10pt;
    font-weight: 500; /* Medium weight */
}

/* Style pour l'icône et le texte quand déployé */
QWidget#sidebarNavigationWidget[expanded="true"] QToolButton:not(#sidebarToggleButton) {
    padding: 10px 12px; /* Padding pour icône + texte */
}

QWidget#sidebarNavigationWidget QToolButton:not(#sidebarToggleButton)::menu-indicator {
    image: none;
}

/* État Survol (Hover) des boutons de module */
QWidget#sidebarNavigationWidget QToolButton:not(#sidebarToggleButton):hover {
    background-color: #CFD8DC; /* Gris clair pour survol */
    color: #007BFF; /* Texte en couleur d'accent */
}

/* État Actif/Sélectionné (:checked) des boutons de module */
QWidget#sidebarNavigationWidget QToolButton:not(#sidebarToggleButton):checked {
    background-color: #007BFF; /* Couleur d'accent pour fond */
    color: white; /* Texte blanc */
    font-weight: bold;
    border-left: 4px solid #0056B3; /* Indicateur latéral bleu foncé */
}

/* Ajustement du padding pour l'état :checked si une bordure est ajoutée */
QWidget#sidebarNavigationWidget QToolButton:not(#sidebarToggleButton):checked {
    padding-left: 8px; /* (padding original icon only) - (largeur bordure) + un peu de marge */
}
QWidget#sidebarNavigationWidget[expanded="true"] QToolButton:not(#sidebarToggleButton):checked {
    padding-left: 8px; /* (padding original déployé) - (largeur bordure) */
}


/* Bouton de Bascule (Toggle) en bas de la Sidebar */
QWidget#sidebarNavigationWidget QToolButton#sidebarToggleButton {
    border: none;
    background-color: transparent;
    padding: 0px;
    border-top: 1px solid #CFD8DC; /* Séparateur au-dessus */
}

QWidget#sidebarNavigationWidget QToolButton#sidebarToggleButton:hover {
    background-color: #B0BEC5; /* Gris plus foncé au survol */
}
/* === Fin des Styles Sidebar Navigation Widget === */

/* === Specific styles for DocumentManager Left Pane === */
QWidget#leftPaneWidget {
    background-color: #F5F7FA; /* A light background for the entire pane */
    border-right: 1px solid #DDE2E6; /* Add a subtle border to separate from right pane */
}

QGroupBox#filterSearchGroup {
    font-weight: bold; /* Already set in global QGroupBox, but can be fine-tuned */
    border: 1px solid #DDE2E6; /* Consistent border */
    border-radius: 6px;
    margin-top: 0; /* No top margin if it's the first element in leftPaneWidget */
    background-color: #FFFFFF; /* White background for the filter area */
}

QGroupBox#filterSearchGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 6px 12px; /* Slightly more padding for the title */
    left: 10px;
    background-color: transparent; /* Ensure it's transparent */
    color: #007BFF; /* Accent color for the title */
    font-size: 10pt;
    font-weight: bold;
}

/* Targeting QLineEdit and QComboBox specifically within the left pane */
QWidget#leftPaneWidget QLineEdit,
QWidget#leftPaneWidget QComboBox {
    padding: 7px 10px; /* Increased padding for a more modern feel */
    border: 1px solid #DDE2E6; /* Standard border */
    border-radius: 4px;
    background-color: #FFFFFF;
    min-height: 30px; /* Consistent height for inputs */
    font-size: 9pt;
}
QWidget#leftPaneWidget QLabel { /* Labels within the left pane, e.g., for filters */
    font-size: 9pt;
    color: #343a40;
    padding-top: 4px; /* Align with input fields better */
    margin-bottom: 2px; /* Small space below label */
    background-color: transparent;
}


QWidget#leftPaneWidget QLineEdit:focus,
QWidget#leftPaneWidget QComboBox:focus {
    border-color: #007BFF; /* Highlight focus with accent color */
}

QWidget#leftPaneWidget QComboBox::drop-down {
    border-left: 1px solid #DDE2E6;
    padding: 0px 6px; /* Space for the arrow */
    width: 20px; /* Explicit width for dropdown button area */
}

QWidget#leftPaneWidget QComboBox::down-arrow {
    image: url(:/icons/chevron-down.svg); /* Ensure this icon is available */
    width: 10px; /* Smaller arrow */
    height: 10px;
}

/* Client List Specific Styling */
QListWidget#clientListWidget {
    border: 1px solid #DDE2E6; /* Consistent border */
    border-radius: 4px;
    background-color: #FFFFFF; /* White background for the list */
    padding: 5px; /* Small padding around the list items */
}

/* Remove default item padding if ClientListItemWidget handles all its spacing */
QListWidget#clientListWidget::item {
    padding: 0px;
    margin: 3px 0px; /* Add a small vertical margin between items for separation */
    border: none; /* Ensure no default item border from QListWidget */
    /* background-color: transparent; Let ClientListItemWidget handle its own bg/hover */
}
QListWidget#clientListWidget::item:selected {
    background-color: transparent; /* Override default selection, ClientListItemWidget could show selection */
    /* Or, if you want QListWidget to show selection: */
    /* background-color: #E3F2FD; */ /* Light blue selection */
    /* border: 1px solid #007BFF; */
}


/* Buttons at the bottom of the left pane */
QWidget#leftPaneWidget QPushButton {
    padding: 8px 12px;
    min-height: 32px; /* Standard height */
    font-size: 10pt; /* Slightly larger font for main action buttons */
    font-weight: 500; /* Medium weight */
    border-radius: 4px;
}

/* Primary button in left pane (e.g., Add New Client) */
QWidget#leftPaneWidget QPushButton#primaryButton {
    background-color: #007BFF;
    color: white;
    border: 1px solid #007BFF;
}
QWidget#leftPaneWidget QPushButton#primaryButton:hover {
    background-color: #0069d9;
    border-color: #0062cc;
}
QWidget#leftPaneWidget QPushButton#primaryButton:disabled {
    background-color: #a0cfff;
    border-color: #a0cfff;
    color: #e0e0e0;
}

/* Pagination buttons */
/* Assuming QPushButton objectNames: prevPageButton, nextPageButton */
/* And QLabel objectName: pageInfoLabel */
QWidget#leftPaneWidget QPushButton#prevPageButton,
QWidget#leftPaneWidget QPushButton#nextPageButton {
    padding: 6px 10px;
    font-size: 9pt;
    min-width: 70px; /* Slightly wider for better text fit */
    background-color: #FFFFFF;
    color: #007BFF;
    border: 1px solid #007BFF;
}
QWidget#leftPaneWidget QPushButton#prevPageButton:hover,
QWidget#leftPaneWidget QPushButton#nextPageButton:hover {
    background-color: #E3F2FD;
}
QWidget#leftPaneWidget QPushButton#prevPageButton:disabled,
QWidget#leftPaneWidget QPushButton#nextPageButton:disabled {
    background-color: #F5F7FA;
    color: #B0BEC5;
    border-color: #DDE2E6;
}

QWidget#leftPaneWidget QLabel#pageInfoLabel {
    font-size: 9pt;
    color: #546E7A;
    padding: 5px;
    background-color: transparent;
    border: none;
}
/* === END of Specific styles for DocumentManager Left Pane === */

/* User Menu Button in Menu Bar */
QPushButton#userMenuButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 16px; /* Half of the button's fixed size (32px / 2) */
    padding: 0px;
    min-width: 32px; /* Consistent with UserMenuButton fixed size */
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    /* icon-size: 20px; */ /* Icon size is best controlled from UserMenuButton.py if precise sizing needed */
}

QPushButton#userMenuButton:hover {
    background-color: #E0E0E0; /* Light grey hover */
}


QPushButton#userMenuButton:pressed {
    background-color: #CFD8DC; /* Slightly darker grey when pressed */
}

QPushButton#userMenuButton::menu-indicator {
    image: none; /* Hide default menu indicator arrow */
}
