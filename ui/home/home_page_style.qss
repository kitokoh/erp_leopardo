/* Styles pour ModuleCardWidget */
QWidget#moduleCard {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 12px; /* Coins plus arrondis */
    padding: 20px;
    min-height: 180px; /* Hauteur augmentée */
    max-width: 320px; /* Largeur augmentée */
    /* Effet d'ombre via Python pour un meilleur contrôle */
}

QWidget#moduleCard:hover {
    border-color: #007BFF;
    background-color: #F9F9F9;
    transform: scale(1.02); /* Effet de zoom léger */
}

QLabel#moduleIconLabel {
    /* qproperty-alignment: 'AlignCenter'; */ /* Géré en code */
    padding-bottom: 10px;
    /* La taille de l'icône est gérée en code (ex: 48x48) */
}

QLabel#moduleTitleLabel {
    font-size: 13pt; /* Un peu plus petit que 14pt initialement proposé pour équilibre */
    font-weight: bold;
    color: #263238; /* Primary Text */
    /* qproperty-alignment: 'AlignCenter'; */ /* Géré en code */
    padding-bottom: 8px;
    min-height: 30px; /* Pour gérer 1 ou 2 lignes de titre */
}

QWidget#statsContainer { /* Le QWidget qui contient les QHBoxLayout des stats */
    background-color: transparent;
    padding-top: 8px;
    border-top: 1px solid #ECEFF1;
    margin-top: auto; /* Pousse le conteneur de stats vers le bas si le layout principal le permet */
}

/* Styles pour les labels de statistiques individuels (valeur et texte) */
QLabel#statValueLabel {
    font-size: 16pt; /* Réduit de 18pt pour ne pas être trop dominant */
    font-weight: bold;
    color: #007BFF; /* Couleur d'accent par défaut */
    /* qproperty-alignment: 'AlignCenter'; */ /* Géré en code */
    padding: 0px;
    margin:0px;
}

QLabel#statTextLabel {
    font-size: 8pt; /* Réduit pour être plus discret */
    color: #546E7A; /* Secondary Text */
    /* qproperty-alignment: 'AlignCenter'; */ /* Géré en code */
    padding: 0px;
    margin:0px;
}

/* Exemples de couleurs d'accentuation par moduleType (propriété dynamique) */
/* La couleur d'accent est appliquée à la valeur de la stat principale */
/* Ou à la bordure de la carte au survol, ou à l'icône */

QWidget#moduleCard[moduleType="clientdocuments"] QLabel#statValueLabel,
QWidget#moduleCard[moduleType="clientdocuments"] QLabel#moduleIconLabel { /* Si icône SVG monochrome */
    color: #007BFF; /* Bleu */
}
QWidget#moduleCard[moduleType="clientdocuments"]:hover {
    border-color: #007BFF;
}

QWidget#moduleCard[moduleType="projectmanagement"] QLabel#statValueLabel,
QWidget#moduleCard[moduleType="projectmanagement"] QLabel#moduleIconLabel {
    color: #28A745; /* Vert */
}
QWidget#moduleCard[moduleType="projectmanagement"]:hover {
    border-color: #28A745;
}

QWidget#moduleCard[moduleType="productmanagement"] QLabel#statValueLabel,
QWidget#moduleCard[moduleType="productmanagement"] QLabel#moduleIconLabel {
    color: #6F42C1; /* Violet */
}
QWidget#moduleCard[moduleType="productmanagement"]:hover {
    border-color: #6F42C1;
}

QWidget#moduleCard[moduleType="recruitment"] QLabel#statValueLabel,
QWidget#moduleCard[moduleType="recruitment"] QLabel#moduleIconLabel {
    color: #FD7E14; /* Orange */
}
QWidget#moduleCard[moduleType="recruitment"]:hover {
    border-color: #FD7E14;
}
/* Ajouter d'autres moduleTypes ici si nécessaire */


/* QLabel pour le GIF */
QLabel#homePageGifLabel {
    background-color: transparent; /* Pas de fond pour le label du GIF */
    /* La taille sera gérée par le QMovie et la politique de taille du widget */
}

/* Conteneur pour la zone inférieure (ex: statistiques) */
QStackedWidget#homePageBottomContentArea {
    /* background-color: lightblue; */ /* Pour débogage de la zone */
    /* border-top: 1px solid #DDE2E6; */ /* Séparateur optionnel, removed as the new layout has sections */
    /* min-height: 200px; */ /* Hauteur minimale si nécessaire */
}

/* Promotional Areas Styling */
QFrame#leftPromoArea, QFrame#rightPromoArea {
    background-color: #E9ECEF; /* Un gris clair, différent du fond principal */
    border: 1px solid #CED4DA; /* Bordure subtile */
    border-radius: 8px; /* Coins arrondis */
}

/* Styling for PromoSectionWidget */
QFrame#PromoSectionWidget {
    background-color: #FFFFFF; /* White background for the promo card */
    border: 1px solid #DEE2E6; /* Lighter border color */
    border-radius: 6px;        /* Slightly smaller border radius */
    /* padding: 10px; */ /* Padding is handled by the widget's internal layout margins now */
}

QFrame#PromoSectionWidget:hover {
    border-color: #007BFF; /* Highlight border on hover */
    /* background-color: #F8F9FA; */ /* Optional: Slight background change on hover */
}

QLabel#promoTitleLabel {
    font-family: "Open Sans", "Segoe UI", Arial, sans-serif;
    font-size: 14px;           /* Adjust size as needed */
    font-weight: bold;
    color: #0056B3;        /* Darker blue for title */
    padding-bottom: 4px;       /* Space below the title */
    /* background-color: lightcoral; */ /* Debug color */
}

QLabel#promoBodyLabel {
    font-family: "Open Sans", "Segoe UI", Arial, sans-serif;
    font-size: 12px;           /* Adjust size as needed */
    color: #343A40;            /* Standard dark grey for body text */
    line-height: 1.5;          /* Improve readability for wrapped text */
    /* background-color: lightblue; */ /* Debug color */
}


/* Remove old styling for QFrame#leftPromoArea and QFrame#rightPromoArea if they are no longer used directly */
/* QFrame#leftPromoArea, QFrame#rightPromoArea { ... } */
/* QFrame#leftPromoArea QLabel, QFrame#rightPromoArea QLabel { ... } */


/* Styling for QuickStatsWidget */
QFrame#QuickStatsWidget {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QLabel#quickStatsTitleLabel {
    font-family: "Open Sans", "Segoe UI", Arial, sans-serif;
    font-size: 15px;
    font-weight: bold;
    color: #0056B3;
    padding-bottom: 8px;
    margin-bottom: 5px;
    border-bottom: 1px solid #E9ECEF;
}

QLabel#quickStatItemLabel {
    font-family: "Open Sans", "Segoe UI", Arial, sans-serif;
    font-size: 12px;
    color: #343A40;
}

QLabel#quickStatValueLabel {
    font-family: "Open Sans", "Segoe UI", Arial, sans-serif;
    font-size: 12px;
    font-weight: bold;
    color: #0056B3;
}

QProgressBar#quickStatProgressBar {
    height: 6px;
    text-align: center;
    border: none;
    border-radius: 3px;
    background-color: #E9ECEF;
}

QProgressBar#quickStatProgressBar::chunk {
    background-color: #007BFF;
    border-radius: 3px;
}

QLabel#quickStatItemPlaceholderLabel {
    font-family: "Open Sans", "Segoe UI", Arial, sans-serif;
    font-size: 12px;
    color: #6c757d;
    font-style: italic;
    padding: 10px;
}

QPushButton#quickStatsRefreshButton {
    background-color: transparent;
    border: none;
    padding: 2px;
    /* color: #007BFF; */ /* Icon color will be from SVG or theme */
}

QPushButton#quickStatsRefreshButton:hover {
    background-color: #E9ECEF; /* Light grey on hover */
    border-radius: 3px;
}

QPushButton#quickStatsRefreshButton:pressed {
    background-color: #CED4DA; /* Darker grey on pressed */
}



QFrame#homePageRightSidebar {
    background-color: transparent;
}

QFrame#tipAreaFrame {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    padding: 10px;
}

/* Search Bar Styling */
QLineEdit#homePageSearchInput {
    font-family: "Open Sans", "Segoe UI", Arial, sans-serif;
    font-size: 14px; /* Taille de police augmentée */
    padding: 10px 15px; /* Padding augmenté */
    border: 1px solid #CCCCCC;
    border-radius: 20px; /* Coins encore plus arrondis */
    background-color: #FDFDFD;
}

QLineEdit#homePageSearchInput:focus {
    border-color: #007BFF;
    background-color: #FFFFFF;
}

QPushButton#homePageSearchButton {
    background-color: #007BFF;
    border: none;
    color: white;
    border-radius: 20px; /* Match du champ de recherche */
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
}

QPushButton#homePageSearchButton:hover {
    background-color: #0056b3; /* Darker blue on hover */
    border-color: #0056b3;
}

QPushButton#homePageSearchButton:pressed {
    background-color: #004085; /* Even darker blue when pressed */
    border-color: #004085;
}

